# Copy to .env and fill in. .env is gitignored — never commit it.
GITHUB_TOKEN=ghp_your_token_here

# Ollama host for `bgis smoke` reachability check (defaults usually fine).
BGIS_OLLAMA_BASE_URL=http://localhost:11434

# LLM backends + embedding model are configured in llm_config.json (project root), NOT here.
# Point at a different config file with BGIS_LLM_CONFIG=/path/to/llm_config.json if needed.
